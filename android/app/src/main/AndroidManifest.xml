<?xml version="1.0" encoding="utf-8"?>
<!--
    The package.

    There is no Java in it: the activity is the system's own, and the
    system's glue loads the engine's library and calls the entry point. So
    the package is the manifest, the assets and the native library.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The engine draws through Vulkan, and it asks for 1.3. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00401000"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:hasCode="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">

            <!-- The library the system's activity loads: the game. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="ForgeTetris" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
