# EditorConfig helps maintain consistent coding styles
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.cpp]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.h]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.txt]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
