Scene: TetrisGame
Entities:
  - Entity: 1000000001
    TagComponent:
      Tag: GameBoard
    TransformComponent:
      Translation: [0, -10, 0]
      Rotation: [0, 0, 0]
      Scale: [10, 20, 1]
    TetrisBoardComponent:
      Width: 10
      Height: 20
    PBRMaterialComponent:
      Albedo: [0.1, 0.1, 0.15]
      Metallic: 0
      Roughness: 0.8
    MeshComponent:
      ModelPath: resources/models/cube.glb
      Scale: [10, 20, 1]

  - Entity: 1000000002
    TagComponent:
      Tag: GameDisplay
    TransformComponent:
      Translation: [6, -10, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    TetrisDisplayComponent:
      Score: 0
      Level: 1
      LinesCleared: 0
      Combo: 0
      NextPiece: 0
    PBRMaterialComponent:
      Albedo: [0.2, 0.2, 0.3]
      Metallic: 0
      Roughness: 0.5

  - Entity: 1000000003
    TagComponent:
      Tag: NextPiece
    TransformComponent:
      Translation: [6, -5, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    TetrisPieceComponent:
      Type: 0
      State: 0
      GridPosition: [0, 0]
      Color: [0, 1, 1]
    PBRMaterialComponent:
      Albedo: [0, 1, 1]
      Metallic: 0.2
      Roughness: 0.3

  - Entity: 1000000004
    TagComponent:
      Tag: MainCamera
    TransformComponent:
      Translation: [0, 0, 15]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    CameraComponent:
      Primary: true
      FieldOfView: 60
      NearClip: 0.1
      FarClip: 100
    PBRMaterialComponent:
      Albedo: [0.3, 0.3, 0.4]
      Metallic: 0
      Roughness: 0.5
