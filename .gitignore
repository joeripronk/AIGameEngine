# Resources - tracked via git-lfs (see .gitattributes)
# Large binary assets are stored on the remote; git keeps pointer files locally.
# See .gitattributes for which extensions are LFS-tracked.

# Test artifacts
*.forge
!resources/scenes/*.forge
!resources/prefabs/*.forge

# Test artifacts written into the working directory by the test suite
/bad.rt
/test_full_scene.rt
/test_*.forge
/test_*.rt
/test_assets/
/test_asset_scan/
/test_roundtrip/
/test_export/
/test_prefabs/
/test_scripts/
/test_tools/
/test_export_fixtures/
/test_prefab_fixtures/
/test_audio/
test_reverb/
/test_asset_db/
test_tetris_music/

# The Tetris theme is synthesised by the game on first run (games/tetris/src/
# TetrisMusicTrack.cpp): a generated playback file, not an authored asset, so
# it is not tracked. Same rule for every generated song's playback file
# (games/tetris/src/TetrisMusic.cpp writes resources/audio/gen_<song>.wav).
resources/audio/tetris_theme.wav
resources/audio/gen_*.wav

# Tooling dependencies installed by npm; the manifests are tracked, what they
# install is not.
node_modules/

# Editor and debugging scratch
imgui.ini
gdb.txt
Testing/

# One-off debugging notes; kept out of the tree so they are not mistaken for
# current documentation.
BUGFIX-SUMMARY.md
valgrind-summary.md
pipelines-*.vkcache
